---
import type { Language } from '../../shared/content/i18n';
interface Props { lang?: Language }
const { lang = 'zh-Hant' } = Astro.props;
import logo from './assets/logo.png?url';
import { ui } from '../../shared/content/i18n';
---
<header class="lab-identity">
  <div class="identity-name">
    <p class="eyebrow">IRSL LABORATORY</p>
    <h1>{ui[lang].labName}</h1>
  </div>
  <div class="logo-surface"><img class="lab-logo" src={logo} width="478" height="405" alt={`${ui[lang].labName} logo`} /></div>
</header>
<style>
  .lab-identity { display: grid; grid-template-columns: minmax(0, 1fr) 320px; align-items: center; gap: 3rem; padding: .5rem 0 2.5rem; border-bottom: 1px solid var(--line); }
  .identity-name { padding-block: 2rem; }
  .identity-name::before { content: ''; display: block; width: 3rem; border-top: 2px solid var(--accent); margin-bottom: 1.5rem; }
  h1 { font-size: clamp(2.25rem, 4.4vw, 3.75rem); margin-bottom: 0; }
  .logo-surface { padding: 1rem; background: #fff; }
  .lab-logo { width: 100%; }
  @media (max-width: 760px) {
    .lab-identity { grid-template-columns: 1fr; gap: 1.25rem; padding: 0 0 2rem; }
    .identity-name { padding-block: .5rem 0; }
    .identity-name::before { margin-bottom: 1rem; }
    .logo-surface { width: min(100%, 256px); justify-self: center; padding: .75rem; }
  }
</style>
